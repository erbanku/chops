<Window
    x:Class="Chops.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Chops.Views"
    Title="Chops">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="180" MaxWidth="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="300" MinWidth="200" MaxWidth="500" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <views:SidebarView Grid.Column="0" />

        <GridSplitter Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Skill List -->
        <views:SkillListView Grid.Column="2" />

        <GridSplitter Grid.Column="3" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Detail Pane -->
        <views:SkillDetailView Grid.Column="4" />
    </Grid>

</Window>
